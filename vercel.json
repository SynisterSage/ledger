{
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist-web",
  "rewrites": [
    { "source": "/app/runtime-config.js", "destination": "/runtime-config.js" },
    { "source": "/app/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/app/logo-color.svg", "destination": "/logo-color.svg" },
    { "source": "/app/logo.svg", "destination": "/logo.svg" },
    { "source": "/app/logo@2x.svg", "destination": "/logo@2x.svg" },
    { "source": "/app/vite.svg", "destination": "/vite.svg" },
    { "source": "/app/apple.svg", "destination": "/apple.svg" },
    { "source": "/app/drive.svg", "destination": "/drive.svg" },
    { "source": "/app/github-mark.svg", "destination": "/github-mark.svg" },
    { "source": "/app/slack.svg", "destination": "/slack.svg" },
    { "source": "/app/slack-outline.svg", "destination": "/slack-outline.svg" },
    { "source": "/app/loginfourm_dark_4x.webp", "destination": "/loginfourm_dark_4x.webp" },
    { "source": "/app/loginfourm_light_4x.webp", "destination": "/loginfourm_light_4x.webp" },
    { "source": "/app/mcp-icons/:path*", "destination": "/mcp-icons/:path*" },
    { "source": "/app", "destination": "/index.html" },
    { "source": "/app/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://api.ledgerworkspace.com https://*.supabase.co; img-src 'self' data: blob: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://api.ledgerworkspace.com https://*.supabase.co wss://*.supabase.co; frame-src 'self'; upgrade-insecure-requests" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
