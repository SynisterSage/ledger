// @see - https://www.electron.build/configuration/configuration
{
  $schema: 'https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json',
  appId: 'com.ledger.app',
  asar: true,
  asarUnpack: [
    'node_modules/extract-file-icon/**/*',
    'node_modules/node-gyp-build/**/*',
    'node_modules/node-window-manager/**/*',
    'node_modules/electron-acrylic-window/**/*',
  ],
  productName: 'Ledger',
  publish: [
    {
      provider: 'github',
      owner: 'SynisterSage',
      repo: 'ledger',
      releaseType: 'prerelease',
    },
  ],
  // Never ship a macOS build with ad-hoc signing. The audio helper must be
  // signed under the same Developer ID team as Ledger.app for TCC access.
  forceCodeSigning: true,
  directories: {
    output: 'release/${version}',
  },
  files: ['dist', 'dist-electron', 'public'],
  mac: {
    target: ['dmg'],
    identity: 'ALEXANDER RAY FERGUSON (CAY3N8J725)',
    // Use the native macOS iconset so Finder/Dock receive transparent
    // rounded artwork instead of rasterizing the square PNG canvas.
    icon: 'public/logo.icns',
    entitlements: 'entitlements.mac.plist',
    entitlementsInherit: 'entitlements.mac.plist',
    notarize: {
      teamId: 'CAY3N8J725',
    },
    binaries: ['native/LedgerAudioCaptureBridge', 'native/ZoomAccessibilityBridge'],
    extraResources: [
      { from: 'native', to: '.', filter: ['AppleCalendarBridge', 'LedgerAudioCaptureBridge', 'ZoomAccessibilityBridge', 'whisper-cli', 'whisper-server'] },
      { from: 'native/local-ai-runtime', to: 'local-ai-runtime' },
    ],
    artifactName: '${productName}-Mac-${version}-Installer.${ext}',
    extendInfo: {
      NSCalendarsUsageDescription: 'Ledger uses calendar access to show events from calendars you choose alongside your Ledger work.',
      NSCalendarsFullAccessUsageDescription: 'Ledger uses calendar access to show events from calendars you choose alongside your Ledger work.',
      NSRemindersFullAccessUsageDescription: 'Ledger uses Reminders access to show reminders from lists you choose alongside your Ledger work.',
      NSMicrophoneUsageDescription: 'Ledger uses microphone access to capture your voice during Meeting Notes.',
      NSScreenCaptureUsageDescription: 'Ledger uses Screen & System Audio Recording access to capture meeting audio playing through your computer.',
      NSAudioCaptureUsageDescription: 'Ledger uses system-audio access to hear meeting participants during Meeting Notes.',
    },
  },
  win: {
    target: [
      {
        target: 'nsis',
        arch: ['x64'],
      },
    ],
    artifactName: '${productName}-Windows-${version}-Setup.${ext}',
    extraResources: [
      { from: 'native/whisper-cli.exe', to: 'whisper-cli.exe' },
      { from: 'native/whisper-server.exe', to: 'whisper-server.exe' },
      { from: 'native/local-ai-runtime', to: 'local-ai-runtime' },
    ],
    // Windows capture is renderer/Electron based; no macOS native helpers are shipped.
    // The Windows Whisper executable is staged by build:whisper-windows before packaging.
    signAndEditExecutable: true,
    signingHashAlgorithms: ['sha256'],
  },
  nsis: {
    oneClick: false,
    perMachine: false,
    allowToChangeInstallationDirectory: true,
    deleteAppDataOnUninstall: false,
  },
  linux: {
    target: ['AppImage'],
    artifactName: '${productName}-Linux-${version}.${ext}',
  },
}
